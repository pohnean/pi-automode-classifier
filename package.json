{
  "name": "pi-automode-classifier",
  "version": "0.3.0",
  "description": "Auto mode for oh-my-pi (omp): deterministic rules first, then a local decision model, then a chat-model judge, then a confirm prompt",
  "keywords": [
    "auto-mode",
    "guardrails",
    "permissions",
    "decision-model",
    "llama.cpp",
    "omp-plugin",
    "omp-extension"
  ],
  "license": "MIT",
  "author": "Deepu K Sasidharan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepu105/pi-automode-classifier.git"
  },
  "homepage": "https://github.com/deepu105/pi-automode-classifier#readme",
  "bugs": {
    "url": "https://github.com/deepu105/pi-automode-classifier/issues"
  },
  "type": "module",
  "files": [
    "index.ts",
    "rules.ts",
    "automode.ts",
    "automode-rules.json",
    "config.example.jsonc",
    "systemd",
    "lancet",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.mjs",
    "bench": "node bench.mjs",
    "bench:llm": "node bench-llm.mjs"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  }
}
